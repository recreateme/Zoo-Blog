# ============================================================
# VPS 部署配置（复制为 .deploy.env 后填写）
#   copy .deploy.env.example .deploy.env
# 注意：.deploy.env 不提交到 Git
# ============================================================

# VPS SSH
VPS_HOST=204.44.123.242
VPS_PORT=22
VPS_USER=root
VPS_PASSWORD=

# 服务器上的仓库目录（docker compose 所在处）
VPS_REPO_DIR=/var/www/blog/Zoo-Blog

# docker compose 参数（含 RAG 时用 --profile rag）
COMPOSE_ARGS=--profile rag

# 是否在重建后调用 /api/sync（true/false）
TRIGGER_SYNC=true

# ------------------------------------------------------------
# 管理后台「推送到 GitHub / 部署到 VPS」（Docker 推荐 Hook）
# 容器内通常没有可用 .git / SSH 凭据。请在宿主机运行：
#   python scripts/admin-hook-server.py
# 并将下列变量写入服务器 .env（docker compose 会注入 app）：
#
# DEPLOY_HOOK_URL=http://host.docker.internal:9090/
# DEPLOY_HOOK_TOKEN=your-shared-secret
#
# 可选：单独指定 git-sync Hook（默认复用 DEPLOY_HOOK_URL）
# GIT_SYNC_HOOK_URL=http://host.docker.internal:9090/
# GIT_SYNC_FORCE_HOOK=true
#
# 也可把以下变量写进 .env（process.env 优先于本文件）
# ------------------------------------------------------------

# 后台「推送到 GitHub」可选覆盖
# GIT_REMOTE=origin
# GIT_BRANCH=main
# GIT_SYNC_PATHS=content public/images
