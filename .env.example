# ========================
# 数据库
# ========================
DATABASE_URL="file:./dev.db"
# 升级到 PostgreSQL 时替换为：
# DATABASE_URL="postgresql://user:password@localhost:5432/knowledge_blog"

# ========================
# 认证 (NextAuth)
# ========================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-min-32-chars-change-this"

# 管理员账号（首次登录使用）
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="your-secure-password"

# ========================
# AI 服务（Claude API）
# ========================
LLM_PROVIDER="claude"   # claude | openai | deepseek | ollama
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxx"

# OpenAI（备选）
# OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxx"
# OPENAI_BASE_URL="https://api.openai.com/v1"

# DeepSeek（备选）
# DEEPSEEK_API_KEY="sk-xxxxxxxxxxxxxxxxxxxx"

# Ollama 本地模型（备选）
# OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_MODEL="qwen2.5:7b"

# ========================
# 文件存储
# ========================
STORAGE_PROVIDER="local"   # local | minio | s3 | oss
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE="10485760"   # 10MB in bytes

# MinIO（切换时填写）
# MINIO_ENDPOINT="localhost"
# MINIO_PORT="9000"
# MINIO_ACCESS_KEY="minioadmin"
# MINIO_SECRET_KEY="minioadmin"
# MINIO_BUCKET="knowledge-blog"

# S3（切换时填写）
# AWS_ACCESS_KEY_ID="xxxxxxxxxxxxxxxxxxxx"
# AWS_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# AWS_REGION="us-east-1"
# S3_BUCKET="knowledge-blog"

# ========================
# 搜索（Meilisearch Phase 2）
# ========================
# MEILISEARCH_HOST="http://localhost:7700"
# MEILISEARCH_API_KEY="your-meilisearch-master-key"

# ========================
# 向量数据库（Qdrant Phase 3）
# ========================
# QDRANT_URL="http://localhost:6333"
# QDRANT_API_KEY=""

# ========================
# 内容目录
# ========================
CONTENT_DIR="./content"

# ========================
# 站点信息
# ========================
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"
NEXT_PUBLIC_SITE_NAME="个人知识库"
NEXT_PUBLIC_SITE_DESCRIPTION="我的学习笔记与知识积累"
NEXT_PUBLIC_SITE_AUTHOR="Your Name"

# ========================
# Git 备份（可选）
# ========================
# GIT_REMOTE_URL="git@github.com:yourname/knowledge-blog-content.git"
