# ========================
# 数据库
# ========================
DATABASE_URL="file:./prisma/dev.db"
# 升级到 PostgreSQL 时替换为：
# DATABASE_URL="postgresql://user:password@localhost:5432/knowledge_blog"

# ========================
# 认证 (NextAuth)
# ========================
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-min-32-chars-change-this"

# 管理员账号（首次登录使用）
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="your-secure-password"

# ========================
# AI 服务
# ========================
# LLM_PROVIDER：claude | openai | deepseek | ollama | openrouter
LLM_PROVIDER="claude"   # claude | openai | deepseek | ollama | openrouter
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxx"

# OpenAI（直连或任意 OpenAI 兼容代理）
# OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxx"
# OPENAI_BASE_URL="https://api.openai.com/v1"
# OPENAI_MODEL="gpt-4o-mini"

# OpenRouter（聚合多家模型，OpenAI 兼容接口）
# LLM_PROVIDER="openrouter"
# OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxx"
# OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"   # 见 https://openrouter.ai/models
# OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"  # 默认值，一般无需改

# 问答接口：默认需登录；设为 true 允许公开访问（注意 API 费用）
# ASK_PUBLIC="false"

# 向量检索最低相关度（Cosine，0~1，默认 0.35）
# VECTOR_MIN_SCORE="0.35"

# DeepSeek（备选）
# DEEPSEEK_API_KEY="sk-xxxxxxxxxxxxxxxxxxxx"

# Ollama 本地模型（备选）
# OLLAMA_BASE_URL="http://localhost:11434"
# OLLAMA_MODEL="qwen2.5:7b"

# ========================
# 文件存储
# ========================
STORAGE_PROVIDER="local"   # local | minio | s3
UPLOAD_DIR="./public/uploads"
MAX_FILE_SIZE="10485760"   # 10MB in bytes

# MinIO（切换时填写）
# MINIO_ENDPOINT="localhost"
# MINIO_PORT="9000"
# MINIO_ACCESS_KEY="minioadmin"
# MINIO_SECRET_KEY="minioadmin"
# MINIO_BUCKET="knowledge-blog"
# MINIO_PUBLIC_URL="http://localhost:9000/knowledge-blog"
# MINIO_USE_SSL="false"
# MINIO_PUBLIC_READ="true"

# S3（切换时填写）
# AWS_ACCESS_KEY_ID="xxxxxxxxxxxxxxxxxxxx"
# AWS_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# AWS_REGION="us-east-1"
# S3_BUCKET="knowledge-blog"
# S3_PUBLIC_URL="https://knowledge-blog.s3.us-east-1.amazonaws.com"
# S3_ENDPOINT=""   # 兼容 MinIO / 其他 S3 兼容服务时填写

# ========================
# 搜索（Meilisearch）
# ========================
# 本地开发 / PM2 部署（连接本机或 VPS 上的 Meilisearch）
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="local-dev-master-key-16b"
# Docker Compose 部署时无需修改此项——compose 会在 app 容器内覆盖为：
# MEILISEARCH_HOST=http://meilisearch:7700

# ========================
# 向量数据库（Qdrant Phase 3 / RAG）
# ========================
# docker compose --profile rag up -d
# QDRANT_URL="http://localhost:6333"
# Docker Compose 部署时 compose 会在 app 容器内覆盖为 http://qdrant:6333
# QDRANT_API_KEY=""

# ========================
# Embedding（RAG 向量化）
# ========================
# EMBEDDING_PROVIDER="openai"   # openai | ollama
# EMBEDDING_MODEL="text-embedding-3-small"
# EMBEDDING_DIMENSION="1536"
# EMBEDDING_API_KEY=""          # 默认可复用 OPENAI_API_KEY 或 OPENROUTER_API_KEY
# EMBEDDING_BASE_URL=""         # OpenRouter 填 https://openrouter.ai/api/v1
# OpenRouter Embedding 示例：EMBEDDING_MODEL=openai/text-embedding-3-small
# Ollama 本地：EMBEDDING_PROVIDER=ollama，EMBEDDING_MODEL=nomic-embed-text，EMBEDDING_DIMENSION=768

# ========================
# 内容目录
# ========================
CONTENT_DIR="./content"

# ========================
# 内容同步密钥（rsync 脚本自动触发 /api/sync）
# ========================
# 与 .sync.env 中 SYNC_SECRET 保持一致；留空则仅允许后台登录后手动同步
SYNC_SECRET="your-random-sync-secret-min-32-chars"

# ========================
# 站点信息
# ========================
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"
NEXT_PUBLIC_SITE_NAME="PLAIN MLOG"
NEXT_PUBLIC_SITE_DESCRIPTION="学习笔记与技术沉淀"
NEXT_PUBLIC_SITE_AUTHOR="Your Name"

# 文章页「编辑此页」链接（指向仓库中 Markdown，需已同步并填写 filePath）
# NEXT_PUBLIC_CONTENT_GITHUB_URL="https://github.com/yourname/yourrepo/blob/main/content"

# ========================
# Git 备份（可选）
# ========================
# GIT_REMOTE_URL="git@github.com:yourname/knowledge-blog-content.git"
