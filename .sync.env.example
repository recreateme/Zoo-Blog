# ============================================================
# 本地笔记同步配置
# 使用：cp .sync.env.example .sync.env
#       然后编辑 .sync.env 填写实际配置
# 注意：.sync.env 不提交到 Git
# ============================================================

# 本地笔记目录（Obsidian Vault 或其他 Markdown 目录）
LOCAL_NOTES_DIR="$HOME/Documents/MyNotes"

# VPS 连接信息
VPS_HOST="123.45.67.89"        # VPS IP 地址或域名
VPS_PORT="22"                   # SSH 端口（默认 22）
VPS_USER="root"                 # SSH 用户名
VPS_CONTENT_DIR="/var/www/blog/content"   # 服务器上的 content 目录

# 同步完成后是否触发服务端重新索引
# 设为 true 时，新增的 Markdown 文件会自动导入数据库
TRIGGER_REINDEX=true

# 博客地址（用于触发重新索引）
BLOG_URL="https://yourdomain.com"
